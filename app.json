{
  "expo": {
    "name": "FinanzasIA",
    "slug": "finanzas-ia",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "finanzasia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0B2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.finanzasia"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F0B2E",
          "dark": {
            "backgroundColor": "#0F0B2E"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "FinanzasIA necesita acceso a tus fotos para escanear comprobantes.",
          "cameraPermission": "FinanzasIA necesita acceso a la cámara para escanear comprobantes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
